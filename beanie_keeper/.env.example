# ── EVM Configuration
# Node connection & Environment
RPC_URL=https://mainnet.base.org
CHAIN_NAME=base

# Smart Contract Addresses (EVM format)
TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bda02913
FACTORY_ADDRESS=0x1234567890abcdef1234567890abcdef12345678
WEBHOOK_REGISTRY_ADDRESS=0x1234567890abcdef1234567990abcdef12345689

# Block Scanning Sync Heights
REGISTRY_START_BLOCK=15000000
WEBHOOK_REGISTRY_START_BLOCK=15000000
START_BLOCK=15000000

# Cryptographic Identity
# 64-character hex private key for transaction & webhook signing
SWEEP_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


# ── Starknet Configuration (Missing Configs Added Below)
# Node connection & Account Address
STARKNET_RPC_URL=https://starknet-mainnet.public.blastapi.io
KEEPER_ADDRESS=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Private Key (Felt hex format)
STARKNET_SWEEP_PRIVATE_KEY=0x00123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef


# ── Performance Settings (Shared Defaults)
# OPTIONAL: Loop delay execution interval in seconds. Defaults to 12 if omitted.
POLL_INTERVAL_SECS=1

# OPTIONAL: Max block range per eth_getLogs / get_events chunk.
# Defaults to 2000 for EVM and 1000 for Starknet if omitted.
LOG_CHUNK_BLOCKS=2000