# ── EVM Configuration
# Node connection & Environment
BASE_RPC_URL=https://base-mainne....
STARKNET_RPC_URL=https://starknet-mainnet.....

# Smart Contract Addresses (EVM format)
BASE_TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
BASE_FACTORY_ADDRESS=0x4e00d7985799da53d529677410996a6B49DFD5BF
WEBHOOK_REGISTRY_ADDRESS=0x4389822B42deA140EaCcb060C648eECff42BBb61

# Smart Contract Addresses (SN format)
STARKNET_TOKEN_ADDRESS=0x33068f6539f8e6e6b131e6b2b814e6c34a5224bc66947c47dab9dfee93b35fb
STARKNET_FACTORY_ADDRESS=0x01d4a73b58909eb341e6357bd085fea917d71c386ebaecd770792f7b5a34615a

# Block Scanning Sync Heights
REGISTRY_START_BLOCK=
WEBHOOK_REGISTRY_START_BLOCK=
BASE_START_BLOCK=
STARKNET_START_BLOCK=

# Cryptographic Identity
# 64-character hex private key for transaction & webhook signing
BASE_SWEEP_PRIVATE_KEY=

# Private Key (Felt hex format)
# Ensure the key does not exceed the 251-bit field limit
STARKNET_SWEEP_PRIVATE_KEY=

# ── Starknet Configuration (Missing Configs Added Below)
# Node connection & Account Address
STARKNET_KEEPER_ADDRESS=

# ── Performance Settings (Shared Defaults)
# OPTIONAL: Loop delay execution interval in seconds. Defaults to 12 if omitted.
POLL_INTERVAL_SECS=1

# OPTIONAL: Max block range per eth_getLogs / get_events chunk.
# Defaults to 2000 for EVM and 1000 for Starknet if omitted.
LOG_CHUNK_BLOCKS=1