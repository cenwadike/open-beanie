# ── Node connection & Environment
RPC_URL=https://mainnet.base.org
CHAIN_NAME=base

# ── Smart Contract Addresses (EVM format)
TOKEN_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bda02913
FACTORY_ADDRESS=0x1234567890abcdef1234567890abcdef12345678
WEBHOOK_REGISTRY_ADDRESS=0x1234567890abcdef1234567990abcdef12345689

# ── Block Scanning Sync Heights
REGISTRY_START_BLOCK=15000000
WEBHOOK_REGISTRY_START_BLOCK=15000000
START_BLOCK=15000000

# ── Performance Settings
# OPTIONAL: Loop delay execution interval. Defaults to 12 if missing/commented out
POLL_INTERVAL_SECS=12
# OPTIONAL: Max block range per eth_getLogs chunk. Defaults to 2000 if missing/commented out
LOG_CHUNK_BLOCKS=2000

# ── Cryptographic Identity
# 64-character hex private key for transaction & webhook signing (Keep placeholder text here!)
SWEEP_PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
